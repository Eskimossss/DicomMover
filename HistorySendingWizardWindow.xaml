<Window x:Class="DicomMover.HistorySendingWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мастер отправки сохранённых исследований на PACS" Width="920" Height="700"
        MinWidth="820" MinHeight="580"
        Icon="Assets/dicommover.ico" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <!-- Нижняя панель действий и подтверждения -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ConfirmCheckBox" VerticalAlignment="Center" Margin="4,0,12,0" Checked="ConfirmCheckBox_Changed" Unchecked="ConfirmCheckBox_Changed">
                        <TextBlock x:Name="ConfirmText" Text="Подтверждаю отправку выбранных исследований на целевой PACS" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </CheckBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Content="Поставить в очередь отправки" Style="{DynamicResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0" IsEnabled="False" Click="StartButton_Click"/>
                        <Button x:Name="CancelButton" Content="Закрыть" Padding="16,8" Click="CancelButton_Click"/>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="EnqueueProgressBar" Height="6" Visibility="Collapsed" Margin="4,0"/>
            </StackPanel>
        </Border>

        <!-- Заголовок и фильтры -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Отправка сохранённых исследований на PACS" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Мастер позволяет поставить в очередь отправки существующие исследования для нового или дополнительного PACS без повторной отправки на другие серверы."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="6,2">
                        <TextBlock Text="Целевой PACS (получатель)*" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PacsCombo" DisplayMemberPath="Name" SelectionChanged="FilterControl_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,2">
                        <TextBlock Text="Отслеживаемая папка" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="FolderCombo" DisplayMemberPath="Name" SelectionChanged="FilterControl_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="6,2">
                        <TextBlock Text="Модальность" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ModalityCombo" SelectionChanged="FilterControl_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="6,10,6,2">
                        <TextBlock Text="С даты исследования (StudyDate)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="FromDatePicker" SelectedDateChanged="FilterControl_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,10,6,2">
                        <TextBlock Text="По дату исследования (StudyDate)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="ToDatePicker" SelectedDateChanged="FilterControl_Changed"/>
                    </StackPanel>

                    <Button Grid.Row="1" Grid.Column="2" Content="↻  Обновить предпросмотр" VerticalAlignment="Bottom" Height="32" Margin="6,0,6,2" Click="RefreshButton_Click"/>
                </Grid>
            </Border>

            <!-- Блок сводки и предупреждения о массовой отправке -->
            <Border x:Name="WarningPanel" Visibility="Collapsed" Background="#FEF3F2" BorderBrush="#FDA29B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠️" FontSize="20" Margin="4,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Предупреждение о массовой отправке" FontWeight="SemiBold" Foreground="#B42318"/>
                        <TextBlock x:Name="WarningText" Text="Массовая отправка создаст повышенную сетевую нагрузку на PACS. Отправка будет происходить последовательно через стандартную очередь монитора." Foreground="#B42318" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Таблица предпросмотра -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="SummaryCountText" Grid.Row="0" Text="Выберите целевой PACS для расчета количества исследований к отправке." FontWeight="SemiBold" Margin="2,4,0,4"/>
            <TextBlock x:Name="MissingFilesReportText" Grid.Row="1" Text="" Foreground="#B42318" Margin="2,0,0,6" Visibility="Collapsed"/>

            <DataGrid Grid.Row="2" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                      BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" RowHeight="32" RowBackground="{DynamicResource SurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource SurfaceAltBrush}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО пациента" Binding="{Binding PatientName}" Width="1.5*"/>
                    <DataGridTextColumn Header="Дата (StudyDate)" Binding="{Binding StudyDate}" Width="130"/>
                    <DataGridTextColumn Header="Модальность" Binding="{Binding Modality}" Width="90"/>
                    <DataGridTextColumn Header="Путь к файлу" Binding="{Binding FilePath}" Width="2.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
