<Window x:Class="DicomMover.ResolveEncodingProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Решение проблемы кодировки" Width="780" Height="700"
        Icon="Assets/dicommover.ico" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Применить и повторить отправку" Style="{DynamicResource PrimaryButton}" Padding="16,8" Margin="0,0,10,0" IsDefault="True" Click="ApplyButton_Click"/>
            <Button Content="Отмена" Padding="16,8" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Настройка перекодировки для отправки" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <!-- Блок информации об объекте и аппарате -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Файл:" FontWeight="SemiBold" Margin="0,2,0,4"/>
                        <TextBlock x:Name="FileNameText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,4"/>

                        <TextBlock Text="Расположение:" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,4"/>
                        <TextBlock x:Name="FilePathText" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,4"/>

                        <TextBlock Text="Папка и PACS:" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,4"/>
                        <TextBlock x:Name="FolderAndPacsText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,2,0,4"/>

                        <TextBlock Text="Данные аппарата:" Grid.Row="3" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,4"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,4">
                            <TextBlock Text="Modality: " FontWeight="SemiBold"/><TextBlock x:Name="ModalityText" Margin="0,0,14,0"/>
                            <TextBlock Text="Manufacturer: " FontWeight="SemiBold"/><TextBlock x:Name="ManufacturerText" Margin="0,0,14,0"/>
                            <TextBlock Text="Station: " FontWeight="SemiBold"/><TextBlock x:Name="StationNameText"/>
                        </StackPanel>

                        <TextBlock Text="Причина ошибки:" Grid.Row="4" Foreground="#B42318" Margin="0,2,0,2"/>
                        <TextBlock x:Name="ErrorDetailsText" Grid.Row="4" Grid.Column="1" Foreground="#B42318" TextWrapping="Wrap" Margin="0,2,0,2"/>
                    </Grid>
                </Border>

                <!-- Диагностический блок тегов и сырых байтов -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Диагностика проблемного текстового элемента" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Проблемный тег:" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="ProblemTagText" Grid.Column="1" FontWeight="SemiBold"/>
                        </Grid>

                        <TextBlock Text="Сырые байты (HEX-представление):" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,2"/>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <TextBox x:Name="RawBytesText" FontFamily="Consolas" FontSize="11" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Предпросмотр декодирования в различных кодировках:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DeclaredPreviewText" Text="Заявленная кодировка: —" Margin="0,1"/>
                                <TextBlock Grid.Row="1" x:Name="Cp1251PreviewText" Text="Windows-1251: —" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,1"/>
                                <TextBlock Grid.Row="2" x:Name="Iso88595PreviewText" Text="ISO-8859-5: —" Margin="0,1"/>
                                <TextBlock Grid.Row="3" x:Name="Utf8PreviewText" Text="UTF-8: —" Margin="0,1"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Выбор решения -->
                <TextBlock Text="Исходная кодировка текста (ручное указание):" FontWeight="SemiBold" Margin="0,2,0,4"/>
                <ComboBox x:Name="SourceEncodingCombo" SelectedIndex="0" Margin="0,0,0,10" Height="30">
                    <ComboBoxItem Content="Windows-1251 (рекомендуется для российских рентгенов и КТ)"/>
                    <ComboBoxItem Content="UTF-8 (Unicode)"/>
                    <ComboBoxItem Content="ISO-8859-5 (стандартная кириллица DICOM)"/>
                </ComboBox>

                <TextBlock Text="Область действия решения:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton x:Name="OneTimeRadio" IsChecked="True" Margin="0,0,0,6" Checked="Radio_Changed">
                    <TextBlock Text="Разовое исправление: сохранить решение в SQLite и отправить только это исследование (сохраняется при перезапуске)"/>
                </RadioButton>
                <RadioButton x:Name="PermanentRadio" Margin="0,0,0,6" Checked="Radio_Changed">
                    <TextBlock x:Name="PermanentRadioText" Text="Создать постоянное правило для источника и PACS"/>
                </RadioButton>

                <!-- Условия аппарата для постоянного правила -->
                <Border x:Name="HardwareConditionsPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="20,2,0,8">
                    <StackPanel>
                        <TextBlock Text="Условия соответствия аппарата (опционально):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="MatchModalityCheck" Content="Фильтровать по Modality:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="ModalityBox" Height="26"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="MatchManufacturerCheck" Content="Фильтровать по Manufacturer:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="ManufacturerBox" Height="26"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="MatchStationNameCheck" Content="Фильтровать по Station Name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="StationNameBox" Height="26"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Целевая кодировка при отправке на PACS: UTF-8 (ISO_IR 192). Проблема будет автоматически закрыта после успешного завершения C-STORE."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
