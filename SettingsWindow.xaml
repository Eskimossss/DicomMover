<Window x:Class="DicomMover.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DicomMover"
        Title="Настройки DicomMover" Width="980" Height="720" MinWidth="820" MinHeight="600"
        Icon="Assets/dicommover.ico" WindowStartupLocation="CenterOwner"
        Background="#F4F7FB" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <local:ZeroToEmptyConverter x:Key="ZeroToEmptyConverter"/>
        <local:PacsEndpointConverter x:Key="PacsEndpointConverter"/>
        <Style TargetType="Button"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="4,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,3,0,10"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,3,0,10"/></Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#475467"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="HintStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#667085"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,-6,0,10"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/></Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0" Padding="10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True"/>
                <Button Content="Сохранить" Click="Save_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" FontWeight="SemiBold" Padding="20,8"/>
            </StackPanel>
        </Border>

        <TabControl Background="Transparent" BorderBrush="#D9E0EA">
            <TabItem Header="Папки">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Наблюдаемые папки" FontSize="16" FontWeight="SemiBold" Margin="6,4,6,10"/>
                            <ListBox Grid.Row="1" x:Name="FoldersGrid" ItemsSource="{Binding WatchFolders}" SelectionChanged="FoldersGrid_SelectionChanged" BorderThickness="0">
                                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="#667085" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="Отключена" Foreground="#B42318"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,10,2,2"><Button Content="＋ Добавить" Click="AddFolder_Click"/><Button Content="Удалить" Click="RemoveFolder_Click"/></StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding SelectedItem, ElementName=FoldersGrid}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="Параметры папки" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <CheckBox Content="Папка включена" IsChecked="{Binding Enabled}" Margin="0,0,0,14"/>
                            <TextBlock Text="Название" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Путь" Style="{StaticResource LabelStyle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderPathText" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Выбрать…" Margin="8,3,0,10" Click="BrowseFolder_Click"/></Grid>
                            <CheckBox Content="Искать DICOM в подпапках" IsChecked="{Binding SearchSubfolders}" Margin="0,0,0,14"/>
                            <TextBlock Text="Отправлять исследования с даты" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding SendStudiesFromDate}" Margin="0,3,0,2"/><TextBlock Text="Используется DICOM Study Date (0008,0020). Пустое поле отключает ограничение." Style="{StaticResource HintStyle}"/>
                            <TextBlock Text="PACS назначения" Style="{StaticResource LabelStyle}"/><ItemsControl x:Name="FolderPacsPanel" Margin="0,5,0,14"/>
                            <TextBlock Text="После успешной отправки" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="PostActionCombo" SelectedValue="{Binding PostSendAction}" SelectedValuePath="Value" DisplayMemberPath="Name" SelectionChanged="PostActionCombo_SelectionChanged"/>
                            <TextBlock x:Name="ArchiveFolderLabel" Text="Папка архива" Style="{StaticResource LabelStyle}"/>
                            <Grid x:Name="ArchiveFolderPanel"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ArchiveFolderText" Text="{Binding ArchiveFolder, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Выбрать…" Margin="8,3,0,10" Click="BrowseArchive_Click"/></Grid>
                            <CheckBox x:Name="PreserveSubfoldersCheck" Content="Сохранять структуру подпапок" IsChecked="{Binding PreserveSubfolders}" Margin="0,0,0,2"/>
                            <TextBlock Text="Работает только в режиме «В архив»: воспроизводит в архиве структуру каталогов относительно наблюдаемой папки." Style="{StaticResource HintStyle}" Margin="20,0,0,10"/>
                            <CheckBox x:Name="DeleteEmptySubfoldersCheck" Content="Удалять пустые подпапки" IsChecked="{Binding DeleteEmptySubfolders}" Margin="0,0,0,2"/>
                            <TextBlock Text="Работает в режимах «Удалить» и «В архив»: удаляет опустевшие вложенные папки. Корневая наблюдаемая папка не удаляется." Style="{StaticResource HintStyle}" Margin="20,0,0,0"/>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="PACS">
                <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Серверы PACS" FontSize="16" FontWeight="SemiBold" Margin="6,4,6,10"/>
                        <ListBox Grid.Row="1" x:Name="PacsGrid" ItemsSource="{Binding PacsServers}" BorderThickness="0">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Foreground="#667085" FontSize="11"><TextBlock.Text><MultiBinding Converter="{StaticResource PacsEndpointConverter}"><Binding Path="IpAddress"/><Binding Path="Port"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,10,2,2"><Button Content="＋ Добавить" Click="AddPacs_Click"/><Button Content="Удалить" Click="RemovePacs_Click"/></StackPanel>
                    </Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding SelectedItem, ElementName=PacsGrid}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Параметры PACS" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <CheckBox Content="PACS включён" IsChecked="{Binding Enabled}" Margin="0,0,0,14"/>
                        <TextBlock Text="Название" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IP-адрес" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Порт" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ZeroToEmptyConverter}}"/></StackPanel></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Called AE" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding CalledAeTitle, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Calling AE" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding CallingAeTitle, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                        <TextBlock Text="AE Title содержит не более 16 символов." Style="{StaticResource HintStyle}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Таймаут подключения, сек." Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding ConnectionTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Сколько ждать установления DICOM-соединения. После таймаута PACS считается временно недоступным." Style="{StaticResource HintStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Таймаут отправки, сек." Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding SendTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Максимальное время C-STORE одного файла. После таймаута отправка считается неуспешной." Style="{StaticResource HintStyle}"/></StackPanel></Grid>
                        <Button Content="Проверить C-ECHO" HorizontalAlignment="Left" Margin="0,8,0,0" Background="#2563EB" Foreground="White" Click="Echo_Click"/>
                    </StackPanel></ScrollViewer></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Мониторинг"><Border Style="{StaticResource Card}" Margin="14" MaxWidth="680" HorizontalAlignment="Left"><StackPanel>
                <TextBlock Text="Мониторинг и отправка" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <TextBlock Text="Интервал проверки папок" Style="{StaticResource LabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="ScanIntervalText"/><TextBlock Grid.Column="1" Text="секунд" VerticalAlignment="Center" Margin="8,-7,0,0"/></Grid><TextBlock Text="Как часто проверять наблюдаемые папки на новые файлы." Style="{StaticResource HintStyle}"/>
                <TextBlock Text="Время стабильности файла" Style="{StaticResource LabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="StableTimeText"/><TextBlock Grid.Column="1" Text="секунд" VerticalAlignment="Center" Margin="8,-7,0,0"/></Grid><TextBlock Text="Файл обрабатывается только после того, как его перестали изменять." Style="{StaticResource HintStyle}"/>
                <TextBlock Text="Максимум ошибок C-STORE" Style="{StaticResource LabelStyle}"/><TextBox x:Name="MaxAttemptsText" Width="140" HorizontalAlignment="Left"/><TextBlock Text="После достижения лимита автоматические повторы прекращаются. Недоступность сети или PACS этот лимит не расходует." Style="{StaticResource HintStyle}"/>
            </StackPanel></Border></TabItem>

            <TabItem Header="Журнал"><Border Style="{StaticResource Card}" Margin="14" MaxWidth="700" HorizontalAlignment="Left"><StackPanel>
                <TextBlock Text="Журнал приложения" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <CheckBox x:Name="DetailedLogCheck" Content="Подробный журнал сканирования" Margin="0,0,0,10"/>
                <CheckBox x:Name="LogPatientNamesCheck" Content="Записывать ФИО пациентов в журнал" Margin="0,0,0,4"/>
                <TextBlock Text="ФИО является персональной информацией. Включайте этот параметр только при необходимости." Foreground="#B54708" FontSize="12" Margin="20,0,0,18"/>
                <TextBlock Text="Хранить дневные файлы журнала" Style="{StaticResource LabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="LogDaysText"/><TextBlock Grid.Column="1" Text="дней" VerticalAlignment="Center" Margin="8,-7,0,0"/></Grid>
                <TextBlock Text="На главном экране журнал можно фильтровать по уровню. На диске сохраняется один общий ежедневный файл." Style="{StaticResource HintStyle}"/>
            </StackPanel></Border></TabItem>

            <TabItem Header="Хранение"><Border Style="{StaticResource Card}" Margin="14" MaxWidth="700" HorizontalAlignment="Left"><StackPanel>
                <TextBlock Text="История и резервные копии" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <TextBlock Text="Показывать успешные записи" Style="{StaticResource LabelStyle}"/><TextBox x:Name="UiHoursText" Width="140" HorizontalAlignment="Left"/><TextBlock Text="Количество часов, после которого успешные записи скрываются из основной таблицы." Style="{StaticResource HintStyle}"/>
                <TextBlock Text="Хранить историю SQLite, дней" Style="{StaticResource LabelStyle}"/><TextBox x:Name="DatabaseDaysText" Width="140" HorizontalAlignment="Left"/>
                <TextBlock Text="Хранить резервные копии, дней" Style="{StaticResource LabelStyle}"/><TextBox x:Name="BackupDaysText" Width="140" HorizontalAlignment="Left"/>
                <CheckBox x:Name="DatabaseIntegrityCheck" Content="Еженедельно проверять целостность SQLite" Margin="0,4,0,16"/>
                <WrapPanel><Button Content="Создать копию SQLite" Click="BackupDatabase_Click"/><Button Content="Экспортировать настройки" Click="ExportSettings_Click"/><Button Content="Импортировать настройки" Click="ImportSettings_Click"/></WrapPanel>
            </StackPanel></Border></TabItem>

            <TabItem Header="Запуск и интерфейс"><Border Style="{StaticResource Card}" Margin="14" MaxWidth="700" HorizontalAlignment="Left"><StackPanel>
                <TextBlock Text="Запуск и поведение окна" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <CheckBox x:Name="StartWithWindowsCheck" Content="Запускать вместе с Windows" Margin="0,0,0,10"/>
                <CheckBox x:Name="AutoStartCheck" Content="Автоматически начинать мониторинг" Margin="0,0,0,10"/>
                <CheckBox x:Name="StartMinimizedCheck" Content="Запускать свёрнутым" Margin="0,0,0,10"/>
                <CheckBox x:Name="MinimizeToTrayCheck" Content="Сворачивать в системный трей"/>
            </StackPanel></Border></TabItem>
        </TabControl>
    </DockPanel>
</Window>
