<Window x:Class="DicomMover.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки DicomMover" Width="980" Height="680"
        Icon="Assets/dicommover.ico" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Padding="18,8" Margin="4" Click="Save_Click"/>
            <Button Content="Отмена" Padding="18,8" Margin="4" IsCancel="True"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="Папки">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="FoldersGrid" ItemsSource="{Binding WatchFolders}" AutoGenerateColumns="False" SelectionChanged="FoldersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Enabled}" Width="45"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="130"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="Подпапки" Binding="{Binding SearchSubfolders}" Width="75"/>
                            <DataGridTemplateColumn Width="135">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Исследования с даты"
                                               ToolTip="Отправлять только DICOM с Study Date (0008,0020), равной или позже указанной. Пусто — без ограничения."/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding SendStudiesFromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectedDateFormat="Short" ToolTip="Минимальная Study Date (0008,0020)."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridComboBoxColumn Header="После отправки" SelectedValueBinding="{Binding PostSendAction}"
                                                    SelectedValuePath="Value" DisplayMemberPath="Name" Width="120" x:Name="PostActionColumn"/>
                            <DataGridTextColumn Header="Архив" Binding="{Binding ArchiveFolder}" Width="2*"/>
                            <DataGridCheckBoxColumn Binding="{Binding PreserveSubfolders}" Width="130">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="Сохранять подпапки"
                                               ToolTip="При архивации сохраняет исходную структуру вложенных папок."/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridCheckBoxColumn Binding="{Binding DeleteEmptySubfolders}" Width="155">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="Удалять пустые подпапки"
                                               ToolTip="Удаляет опустевшие подпапки после удаления или переноса файлов. Корневая папка не удаляется."/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <Button Content="Добавить папку" Padding="10,5" Margin="3" Click="AddFolder_Click"/>
                        <Button Content="Удалить папку" Padding="10,5" Margin="3" Click="RemoveFolder_Click"/>
                        <Button Content="Выбрать путь" Padding="10,5" Margin="3" Click="BrowseFolder_Click"/>
                        <Button Content="Выбрать архив" Padding="10,5" Margin="3" Click="BrowseArchive_Click"/>
                    </StackPanel>
                    <GroupBox Grid.Row="2" Header="Отправлять выбранную папку на PACS" Padding="8">
                        <ItemsControl x:Name="FolderPacsPanel"/>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="PACS">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="PacsGrid" ItemsSource="{Binding PacsServers}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Enabled}" Width="45"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="130"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/>
                            <DataGridTextColumn Header="Порт" Binding="{Binding Port}" Width="65"/>
                            <DataGridTextColumn Header="Called AE" Binding="{Binding CalledAeTitle}" Width="100"/>
                            <DataGridTextColumn Header="Calling AE" Binding="{Binding CallingAeTitle}" Width="100"/>
                            <DataGridTextColumn Binding="{Binding ConnectionTimeoutSeconds}" Width="115">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Подключение, сек."
                                               ToolTip="Сколько секунд ждать установления сетевого DICOM-соединения с PACS. При превышении PACS считается недоступным."/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding SendTimeoutSeconds}" Width="105">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Отправка, сек."
                                               ToolTip="Максимальное время ожидания завершения C-STORE одного DICOM-файла. При превышении отправка считается неуспешной."/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <Button Content="Добавить PACS" Padding="10,5" Margin="3" Click="AddPacs_Click"/>
                        <Button Content="Удалить PACS" Padding="10,5" Margin="3" Click="RemovePacs_Click"/>
                        <Button Content="Проверить C-ECHO" Padding="10,5" Margin="3" Click="Echo_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Мониторинг">
                <Grid Margin="18" MaxWidth="600" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Интервал проверки папок, сек.:" Margin="4"
                               ToolTip="Как часто DicomMover проверяет наблюдаемые папки на наличие новых файлов."/>
                    <TextBox x:Name="ScanIntervalText" Grid.Column="1" Margin="4"
                             ToolTip="Рекомендуемое значение: 45 секунд."/>
                    <TextBlock Text="Время стабильности файла, сек.:" Grid.Row="1" Margin="4"
                               ToolTip="Файл добавляется в очередь, только если его не изменяли указанное время. Защищает от отправки недописанного DICOM."/>
                    <TextBox x:Name="StableTimeText" Grid.Row="1" Grid.Column="1" Margin="4"
                             ToolTip="Рекомендуемое значение: 10 секунд."/>
                    <TextBlock Text="Интервал повторной попытки, сек.:" Grid.Row="2" Margin="4"
                               ToolTip="Через какое время повторить неуспешную отправку на PACS."/>
                    <TextBox x:Name="RetryIntervalText" Grid.Row="2" Grid.Column="1" Margin="4"
                             ToolTip="Рекомендуемое значение: 60 секунд."/>
                    <TextBlock Text="Максимум попыток:" Grid.Row="3" Margin="4"
                               ToolTip="После указанного количества ошибок автоматические повторы прекращаются. Доставку можно повторить вручную."/>
                    <TextBox x:Name="MaxAttemptsText" Grid.Row="3" Grid.Column="1" Margin="4"
                             ToolTip="Рекомендуемое значение: 5 попыток."/>
                </Grid>
            </TabItem>
            <TabItem Header="Автозапуск и журнал">
                <StackPanel Margin="18">
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Запускать вместе с Windows" Margin="4"/>
                    <CheckBox x:Name="AutoStartCheck" Content="Автоматически начинать мониторинг" Margin="4"/>
                    <CheckBox x:Name="StartMinimizedCheck" Content="Запускать свёрнутым" Margin="4"/>
                    <CheckBox x:Name="MinimizeToTrayCheck" Content="Сворачивать в системный трей" Margin="4"/>
                    <CheckBox x:Name="DetailedLogCheck" Content="Подробный журнал" Margin="4"/>
                    <CheckBox x:Name="LogPatientNamesCheck" Content="Записывать ФИО в журнал" Margin="4"/>
                    <CheckBox x:Name="DatabaseIntegrityCheck" Content="Еженедельно проверять целостность SQLite" Margin="4"
                              ToolTip="Выполняет PRAGMA integrity_check и optimize не чаще одного раза в 7 дней."/>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Показывать успешные записи, часов:" Width="260" Margin="4"/><TextBox x:Name="UiHoursText" Width="100" Margin="4"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Хранить дневные журналы, дней:" Width="260" Margin="4"/><TextBox x:Name="LogDaysText" Width="100" Margin="4"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Хранить историю SQLite, дней:" Width="260" Margin="4" ToolTip="Старые успешные и скрытые подробные записи удаляются. SOP UID сохраняются для защиты от дублей."/><TextBox x:Name="DatabaseDaysText" Width="100" Margin="4"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Хранить резервные копии, дней:" Width="260" Margin="4"/><TextBox x:Name="BackupDaysText" Width="100" Margin="4"/></StackPanel>
                    <Separator Margin="4,14"/>
                    <WrapPanel>
                        <Button Content="Экспортировать настройки" Padding="10,6" Margin="4" Click="ExportSettings_Click"/>
                        <Button Content="Импортировать настройки" Padding="10,6" Margin="4" Click="ImportSettings_Click"/>
                        <Button Content="Создать копию SQLite" Padding="10,6" Margin="4" Click="BackupDatabase_Click"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
