<Window x:Class="DicomMover.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе DicomMover" Width="650" Height="440"
        MinWidth="560" MinHeight="390" ResizeMode="CanResize"
        Icon="Assets/dicommover.ico" WindowStartupLocation="CenterOwner"
        Background="#F4F7FB" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Image Source="Assets/dicommover-logo.png" Width="58" Height="58" Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DicomMover" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VersionText" Foreground="#667085"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Portable-программа для автоматической отправки DICOM-файлов на PACS." TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
                        <Grid Width="22" Height="22" Margin="0,0,9,0">
                            <Ellipse Fill="#229ED9"/>
                            <Path Data="M 4,10 L 18,4 L 14,18 L 10.5,13.5 L 8,16 L 8.5,12.5 L 15,6.5 L 7,11.5 Z"
                                  Fill="White" Stretch="Fill" Margin="3.5"/>
                        </Grid>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Связаться с разработчиком: "/>
                            <Hyperlink Click="TelegramLink_Click" Foreground="#168AC0" ToolTip="Открыть Telegram: https://t.me/eskimossss">@eskimossss</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Папка программы" FontWeight="SemiBold"/><TextBox x:Name="ProgramFolderText" IsReadOnly="True"/>
                    <TextBlock Text="База данных SQLite" FontWeight="SemiBold"/><TextBox x:Name="DatabasePathText" IsReadOnly="True"/>
                    <TextBlock Text="Папка журналов" FontWeight="SemiBold"/><TextBox x:Name="LogsFolderText" IsReadOnly="True"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="CheckUpdatesButton" Content="Проверить обновления" HorizontalAlignment="Left" Padding="16,8" Click="CheckUpdatesButton_Click"/>
            <Button Grid.Column="1" Content="Закрыть" IsCancel="True" Padding="20,8"/>
        </Grid>
    </Grid>
</Window>
