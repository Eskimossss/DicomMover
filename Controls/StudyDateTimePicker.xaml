<UserControl x:Class="DicomMover.Controls.StudyDateTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Language="ru-RU" MinHeight="36" PreviewKeyDown="Root_PreviewKeyDown">
    <Grid>
        <Button x:Name="PickerButton" Click="Open_Click" Margin="0" Padding="9,7"
                Background="White" BorderBrush="#CBD5E1" HorizontalContentAlignment="Stretch"
                ToolTip="Выбрать дату и время. Delete — убрать ограничение.">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ValueText" VerticalAlignment="Center" Text="Не ограничено"/>
                <Path Grid.Column="1" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                      Stroke="#667085" StrokeThickness="1.3" Data="M 2,3 L 14,3 14,15 2,15 Z M 2,7 L 14,7 M 5,1 L 5,5 M 11,1 L 11,5"/>
            </Grid>
        </Button>
        <Popup x:Name="EditorPopup" PlacementTarget="{Binding ElementName=PickerButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Opened="EditorPopup_Opened">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,4">
                <StackPanel Width="272" KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock x:Name="PopupTitle" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,8"/>
                    <Calendar x:Name="DateCalendar" SelectedDatesChanged="DateCalendar_SelectedDatesChanged"
                              SelectionMode="SingleDate" HorizontalAlignment="Center" BorderThickness="0" Margin="0"/>
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <CheckBox x:Name="UseTimeCheck" Content="Указать время" Margin="0,0,0,8"
                                      Checked="Time_Changed" Unchecked="Time_Changed"/>
                            <Grid x:Name="TimePanel">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Часы" Foreground="#667085" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="HoursCombo" IsEditable="False" IsTextSearchEnabled="True" Margin="0" Padding="8,6"
                                              AutomationProperties.Name="Часы" SelectionChanged="Time_Changed"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text=":" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Минуты" Foreground="#667085" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="MinutesCombo" IsEditable="False" IsTextSearchEnabled="True" Margin="0" Padding="8,6"
                                              AutomationProperties.Name="Минуты" SelectionChanged="Time_Changed"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="NoTimeHint" Foreground="#667085" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="Сбросить" Click="Clear_Click" HorizontalAlignment="Left" Margin="0"/>
                        <Button Grid.Column="1" Content="Готово" Click="Done_Click" Margin="0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
