<Window x:Class="DicomMover.DicomElementDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подробности DICOM-элемента" Width="760" Height="680" MinWidth="620" MinHeight="480"
        Icon="Assets/dicommover.ico" WindowStartupLocation="CenterOwner" Background="#F4F7FB" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="4,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#344054"/><Setter Property="Margin" Value="0,6,10,2"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="DetailValue" TargetType="TextBox"><Setter Property="IsReadOnly" Value="True"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="0,4"/></Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Копировать всё" HorizontalAlignment="Left" Click="CopyAll_Click"/>
            <Button Content="Закрыть" HorizontalAlignment="Right" IsCancel="True" Padding="20,7"/>
        </Grid>
        <Border Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Исходный DICOM-элемент" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Тег:" Style="{StaticResource DetailLabel}"/><TextBox x:Name="TagText" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                        <TextBlock Text="Название:" Grid.Row="1" Style="{StaticResource DetailLabel}"/><TextBox x:Name="NameText" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                        <TextBlock Text="VR:" Grid.Row="2" Style="{StaticResource DetailLabel}"/><TextBox x:Name="VrText" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                        <TextBlock Text="Исходное значение:" Grid.Row="3" Style="{StaticResource DetailLabel}"/><TextBox x:Name="SourceValueText" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" MaxHeight="90" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Specific Character Set файла:" Grid.Row="4" Style="{StaticResource DetailLabel}"/><TextBox x:Name="SourceCharsetText" Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                        <TextBlock x:Name="ActualEncodingLabel" Text="Определённая кодировка:" Grid.Row="5" Style="{StaticResource DetailLabel}"/><TextBox x:Name="ActualEncodingText" Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                        <TextBlock Text="Способ определения:" Grid.Row="6" Style="{StaticResource DetailLabel}"/><TextBox x:Name="DetectionMethodText" Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                        <TextBlock x:Name="PrivateCreatorLabel" Text="Private Creator:" Grid.Row="7" Style="{StaticResource DetailLabel}"/><TextBox x:Name="PrivateCreatorText" Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                        <TextBlock Text="Статус:" Grid.Row="8" Style="{StaticResource DetailLabel}"/><TextBox x:Name="StatusText" Grid.Row="8" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                        <TextBlock x:Name="ReasonLabel" Text="Причина:" Grid.Row="9" Style="{StaticResource DetailLabel}"/><TextBox x:Name="ReasonText" Grid.Row="9" Grid.Column="1" Style="{StaticResource DetailValue}" MaxHeight="110" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                    <TextBlock Text="Исходные байты (HEX)" Style="{StaticResource DetailLabel}" Margin="0,12,0,4"/>
                    <TextBox x:Name="RawHexText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="72" MaxHeight="130" FontFamily="Consolas" Padding="7"/>
                    <Border x:Name="ConversionPanel" BorderBrush="#DCE4EF" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="После преобразования" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Целевая кодировка:" Style="{StaticResource DetailLabel}"/><TextBox x:Name="TargetEncodingText" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="Значение:" Grid.Row="1" Style="{StaticResource DetailLabel}"/><TextBox x:Name="TransformedValueText" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                            </Grid>
                            <Border BorderBrush="#DCE4EF" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Проверка сохранённого DICOM-файла" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Specific Character Set:" Style="{StaticResource DetailLabel}"/><TextBox x:Name="SavedCharsetText" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                        <TextBlock Text="Значение после повторного открытия:" Grid.Row="1" Style="{StaticResource DetailLabel}"/><TextBox x:Name="ReloadedValueText" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                        <TextBlock Text="Текст совпадает:" Grid.Row="2" Style="{StaticResource DetailLabel}"/><TextBox x:Name="ChangedText" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                        <TextBlock Text="Результат элемента:" Grid.Row="3" Style="{StaticResource DetailLabel}"/><TextBox x:Name="VerificationText" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#DCE4EF" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Результат файла" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <TextBox x:Name="FileVerificationText" Style="{StaticResource DetailValue}" TextWrapping="Wrap"
                                             MaxHeight="110" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
